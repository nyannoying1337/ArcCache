<Window x:Class="ArcCache.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:ArcCache.Core" xmlns:local="using:ArcCache" Title="Arc Cache">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" RequestedTheme="Dark"><Grid.Resources><local:ArtworkConverter x:Key="ArtworkConverter" /><local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="TitleArea" Padding="22,0,150,0"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Text="ARC CACHE" FontWeight="SemiBold" CharacterSpacing="160" /><TextBlock Text="Preview · per-game shader cache" Style="{StaticResource Muted}" /></StackPanel></Grid>
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="206" SelectionChanged="Navigate">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="HomeNav" Content="Home" Tag="Home"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="LibraryNav" Content="My games" Tag="Library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Graphics" Tag="Driver"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Recent actions" Tag="Activity"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems><NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
      <Grid Padding="22,16,22,18">
        <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760" /></Grid.ColumnDefinitions><StackPanel Spacing="20">
            <InfoBar x:Name="HomeDeveloperPreviewNotice" IsOpen="False" IsClosable="False" Severity="Informational" Title="Preview only" Message="This screen uses fake data. Windows, driver files, and game files are untouched." />
            <Grid>
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="HomeGreeting" Text="Home" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="HomeWelcomeText" Text="Your graphics setup and recent games." Style="{StaticResource Muted}" />
              </StackPanel>
            </Grid>
            <Border x:Name="HomeSetupCard" Style="{StaticResource Card}" Background="#FF18382C" BorderBrush="#FF285A43" BorderThickness="1" Padding="22">
              <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6" VerticalAlignment="Center">
                  <TextBlock x:Name="HomeSetupLabel" Text="CHECKING SETUP" FontSize="12" FontWeight="SemiBold" CharacterSpacing="100" Foreground="#FFB4B4B4" />
                  <TextBlock x:Name="HomeSetupTitle" Text="Checking your graphics" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="HomeSetupDetails" Text="Arc Cache is checking your Intel graphics and Windows setting." Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="HomeSetupButton" Grid.Column="1" Content="Set up a game" Click="HomeSetupAction" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
              </Grid>
            </Border>
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="Pick up where you left off" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="View all games" Click="OpenLibrary" HorizontalAlignment="Right" />
              </Grid>
              <StackPanel x:Name="HomeRecentGames" Spacing="8" />
              <TextBlock x:Name="HomeEmptyGames" Text="No games found yet. Refresh your library or add a game to get started." Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="Graphics" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="View details" Click="OpenGraphics" HorizontalAlignment="Right" />
              </Grid>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Graphics chip" FontSize="12" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="HomeGraphicsModel" Text="Checking graphics…" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="HomeGraphicsDriver" Text="Driver not checked yet" FontSize="12" Style="{StaticResource Muted}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="4">
                  <TextBlock Text="Game-specific settings" FontSize="12" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="HomeRoutingStatus" Text="Checking…" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="HomeRoutingDetails" Text="Windows setting status" FontSize="12" Style="{StaticResource Muted}" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="16">
              <StackPanel Spacing="8">
                <Grid><TextBlock Text="Cache and memory" FontSize="18" FontWeight="SemiBold" /><Button Content="Refresh" Click="RefreshGraphicsStats" HorizontalAlignment="Right" /></Grid>
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="PC memory used" FontSize="12" Style="{StaticResource Muted}" /><TextBlock x:Name="GraphicsRam" Text="Not checked yet" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Intel cache on disk" FontSize="12" Style="{StaticResource Muted}" /><TextBlock x:Name="GraphicsCache" Text="Not checked yet" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                </Grid>
                <TextBlock x:Name="GraphicsStatsStatus" Text="Shared by all games" TextWrapping="Wrap" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>
          </StackPanel></Grid>
        </ScrollViewer>
        <Grid x:Name="LibraryPanel" Visibility="Collapsed" MaxWidth="1038" HorizontalAlignment="Left">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12"><StackPanel Spacing="4"><TextBlock Text="My games" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Set up a game once. Arc Cache checks what it loads before enabling cache sizes." Style="{StaticResource Muted}" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Add a game" Click="AddManualGame" /><Button Content="Refresh" Click="RefreshLibrary" /></StackPanel></Grid>
          <InfoBar x:Name="LibraryNotice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,12" />
          <Grid x:Name="LibraryColumns" Grid.Row="2" ColumnSpacing="18" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Grid.Row="0" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <AutoSuggestBox x:Name="Search" PlaceholderText="Search games" TextChanged="SearchChanged"><AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon></AutoSuggestBox>
              <ComboBox x:Name="SourceFilter" Grid.Row="1" HorizontalAlignment="Stretch" SelectionChanged="SourceChanged" />
              <ComboBox x:Name="GameStatusFilter" Grid.Row="2" HorizontalAlignment="Stretch" SelectionChanged="StatusFilterChanged" />
              <ListView x:Name="GamesList" Grid.Row="3" SelectionChanged="GameSelected" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate><DataTemplate x:DataType="core:SteamGame"><Grid Padding="8,10" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Width="40" Height="40"><Grid><FontIcon Glyph="&#xE7FC;" FontSize="18" /><Image Source="{Binding IconSources, Converter={StaticResource ArtworkConverter}}" Stretch="UniformToFill" /></Grid></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" /><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind SupportLabel}" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" /><Border Background="#FF8E2430" CornerRadius="6" Padding="6,1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind AntiCheatTooltip}" Visibility="{Binding HasAlwaysOnAntiCheat,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{x:Bind AntiCheatBadge}" FontSize="11" Foreground="White" /></Border><Border Background="#FF7A5300" CornerRadius="6" Padding="6,1" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind AntiCheatTooltip}" Visibility="{Binding HasOptionalAntiCheat,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{x:Bind AntiCheatBadge}" FontSize="11" Foreground="White" /></Border></StackPanel></StackPanel><Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="7,3" VerticalAlignment="Center" Visibility="{Binding HasNeutralSetupBadge,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{x:Bind SetupBadge}" FontSize="11" /></Border><Border Grid.Column="2" Background="#FF1F6B45" CornerRadius="10" Padding="7,3" VerticalAlignment="Center" Visibility="{Binding SetupReady,Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{x:Bind SetupBadge}" FontSize="11" Foreground="White" /></Border></Grid></DataTemplate></ListView.ItemTemplate>
              </ListView>
              <TextBlock x:Name="LibraryCount" Grid.Row="4" Text="Reading game libraries…" FontSize="12" Style="{StaticResource Muted}" />
              <StackPanel x:Name="LibraryEmptyState" Grid.Row="3" Visibility="Collapsed" />
              <TextBlock x:Name="SearchEmptyState" Grid.Row="3" Text="No games match this search." TextWrapping="Wrap" Style="{StaticResource Muted}" Visibility="Collapsed" />
            </Grid>
            <ScrollViewer Grid.Column="1" Width="720" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" Spacing="12" Width="720" MaxWidth="720" HorizontalAlignment="Stretch">
              <Border x:Name="GameHeaderCard" Style="{StaticResource Card}" Padding="16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="9" Height="96"><Grid><FontIcon x:Name="GamePlaceholder" Glyph="&#xE7FC;" FontSize="34" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Image x:Name="GameArtwork" Stretch="UniformToFill" ImageOpened="ArtworkOpened" ImageFailed="ArtworkFailed" /></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5"><TextBlock x:Name="GameSource" Text="GAME LIBRARY" FontSize="11" CharacterSpacing="120" Style="{StaticResource Muted}" /><TextBlock x:Name="GameTitle" Text="Choose a game" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text,ElementName=GameTitle}" /><TextBlock x:Name="GameStatus" Text="Not set up" Style="{StaticResource Muted}" /></StackPanel></Grid></Border>
              <Border x:Name="GraphicsGateCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel Spacing="8"><TextBlock Text="Finish Graphics setup first" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Arc Cache needs the graphics check and Windows setting before it can set up a game." TextWrapping="Wrap" Style="{StaticResource Muted}" /><Button Content="Open Graphics" Click="OpenGraphics" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Border>
              <InfoBar x:Name="AntiCheatOverrideBar" Severity="Error" IsClosable="False" IsOpen="False" Title="Anti-cheat risk accepted"><InfoBar.ActionButton><HyperlinkButton Content="Turn this off" Click="RevokeAntiCheatRisk" /></InfoBar.ActionButton></InfoBar><Border x:Name="LibraryMessageCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel Spacing="8"><TextBlock x:Name="LibraryMessageTitle" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="LibraryMessageText" TextWrapping="Wrap" Style="{StaticResource Muted}" /><Expander x:Name="SetupAttentionDetails" Header="Details" Visibility="Collapsed"><TextBlock x:Name="SetupAttentionRawDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Expander><Button x:Name="LibraryMessageButton" Content="Choose a game" Click="LibraryMessageAction" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /><HyperlinkButton x:Name="BlockerCheckAgainLink" Content="Check again" Click="RecheckBlockedGame" HorizontalAlignment="Left" Visibility="Collapsed" Padding="0" /><Button x:Name="AntiCheatOverrideButton" Content="Use Arc Cache with this game anyway…" Click="AcceptAntiCheatRisk" HorizontalAlignment="Left" Visibility="Collapsed" Background="#FF5A1A22" BorderBrush="#FFB84452" Foreground="White" /></StackPanel></Border>
              <Border x:Name="GameFlowCard" Style="{StaticResource Card}" Padding="16"><StackPanel Spacing="12">
                <Border x:Name="FlowWarningBorder" Background="#FF3D301E" BorderBrush="#FF805E26" BorderThickness="1" CornerRadius="8" Padding="10" Visibility="Collapsed"><TextBlock x:Name="FlowWarningText" TextWrapping="Wrap" /></Border>
                <Grid x:Name="GameStep1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="GameStep1Mark" Grid.Column="0" Text="1" FontSize="18" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Spacing="5"><Grid><TextBlock Text="Set up this game" FontSize="18" FontWeight="SemiBold" /></Grid><TextBlock x:Name="GameStep1Result" Text="Ready to set up" Style="{StaticResource Muted}" TextWrapping="Wrap" /><TextBlock x:Name="GameStep1Body" TextWrapping="Wrap" Style="{StaticResource Muted}" /><ProgressBar x:Name="GameStep1Progress" Minimum="0" Maximum="100" Height="16" Visibility="Collapsed" /><TextBlock x:Name="GameStep1ProgressText" TextWrapping="Wrap" Style="{StaticResource Muted}" Visibility="Collapsed" /><Button x:Name="SetupGameButton" Content="Set up this game" Click="Step1Action" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Grid>
                <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Grid x:Name="GameStep2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="GameStep2Mark" Grid.Column="0" Text="2" FontSize="18" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Spacing="5"><Grid><TextBlock Text="Launch and check" FontSize="18" FontWeight="SemiBold" /><HyperlinkButton x:Name="ChangeCheckLink" Content="Check again" Click="ChangeGameStep2" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid><TextBlock x:Name="GameStep2Result" Text="Waiting for step 1" Style="{StaticResource Muted}" TextWrapping="Wrap" /><TextBlock x:Name="GameStep2Body" TextWrapping="Wrap" Style="{StaticResource Muted}" /><ProgressBar x:Name="GameFlowProgress" Minimum="0" Maximum="100" Value="0" Height="16" Visibility="Collapsed" /><TextBlock x:Name="GameFlowProgressText" TextWrapping="Wrap" Style="{StaticResource Muted}" Visibility="Collapsed" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="LaunchInitialButton" Content="Launch through Steam" Click="LaunchGame" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /><Button x:Name="StopFlowButton" Content="Stop" Click="StopGameCheck" Visibility="Collapsed" /></StackPanel></StackPanel></Grid>
                <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Grid x:Name="GameStep3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="GameStep3Mark" Grid.Column="0" Text="3" FontSize="18" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Spacing="5"><Grid><TextBlock Text="Cache size" FontSize="18" FontWeight="SemiBold" /><HyperlinkButton x:Name="ChangeSizeLink" Content="Change" Click="ChangeGameStep3" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid><TextBlock x:Name="GameStep3Result" Text="Waiting for step 2" Style="{StaticResource Muted}" TextWrapping="Wrap" /><TextBlock x:Name="GameStep3Body" TextWrapping="Wrap" Style="{StaticResource Muted}" /><StackPanel x:Name="GameSizeOptions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" /><Button x:Name="ApplySizeButton" Content="Apply 1 GB" Click="ApplyGame" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /><Button x:Name="LaunchConfirmButton" Content="Launch through Steam" Click="LaunchGame" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /><ProgressBar x:Name="GameStep3Progress" Minimum="0" Maximum="100" Height="16" Visibility="Collapsed" /><TextBlock x:Name="GameStep3ProgressText" TextWrapping="Wrap" Style="{StaticResource Muted}" Visibility="Collapsed" /><Button x:Name="StopSizeCheckButton" Content="Stop" Click="StopGameCheck" Visibility="Collapsed" HorizontalAlignment="Left" /></StackPanel></Grid>
              </StackPanel></Border>
              <Border x:Name="MyGamesAdvancedCard" Style="{StaticResource Card}" HorizontalAlignment="Stretch"><Expander x:Name="MyGamesAdvanced" Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10" Margin="0,8,0,0"><Button x:Name="RestoreButton" Content="Use default settings…" Click="RestoreGame" HorizontalAlignment="Left" /><Button x:Name="RemoveManualButton" Content="Remove from library" Click="RemoveManualGame" Visibility="Collapsed" HorizontalAlignment="Left" /><Button x:Name="ImportButton" Content="Import saved setup record…" Click="ImportSetup" HorizontalAlignment="Left" /><TextBlock x:Name="RuntimeStatus" Text="Loaded driver checks appear here after launch." TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ObserveButton" Content="Check what loaded" Click="ObserveGame" /><Button x:Name="MonitorButton" Content="Show on-screen stats" Click="ToggleCacheMonitor" /></StackPanel><TextBlock x:Name="RuntimeDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /><TextBlock x:Name="GameDetails" Text="Select a game to see its folders and saved setup record." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /></StackPanel></Expander></Border>
              <Border x:Name="ScsCard" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel Spacing="10"><TextBlock Text="Prepare shaders with SCSKiller" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ScsSummary" Text="Optional. This uses the normal driver and the default cache size." TextWrapping="Wrap" Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock x:Name="ScsToolText" Text="Checking which SCSKiller is selected…" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource Muted}" /><HyperlinkButton Content="Change" Click="ChooseScsCli" Padding="4,0" VerticalAlignment="Center" /></StackPanel><StackPanel x:Name="ScsDetails" Spacing="2" MaxWidth="760" HorizontalAlignment="Stretch" /><StackPanel x:Name="ScsProgressPanel" Spacing="4" Visibility="Collapsed"><TextBlock x:Name="ScsProgressText" TextWrapping="Wrap" FontWeight="SemiBold" /><ProgressBar x:Name="ScsProgress" Maximum="100" Height="16" /><TextBlock x:Name="ScsProgressDetail" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource Muted}" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ScsStatusButton" Content="Check available shaders" Click="ScsStatus" /><Button x:Name="ScsCompileButton" Content="Prepare shaders…" Click="ScsCompile" /><Button x:Name="ScsCancelButton" Content="Stop" Click="CancelScs" Visibility="Collapsed" /></StackPanel><Expander x:Name="ScsAdvanced" Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10" Margin="0,8,0,0"><ComboBox x:Name="ScsThreads" Header="Compile threads" MinWidth="200" SelectionChanged="ScsThreadsChanged"><ComboBoxItem Content="Automatic" Tag="0" /><ComboBoxItem Content="2 threads" Tag="2" /><ComboBoxItem Content="4 threads" Tag="4" /><ComboBoxItem Content="6 threads" Tag="6" /><ComboBoxItem Content="8 threads" Tag="8" /><ComboBoxItem Content="12 threads" Tag="12" /><ComboBoxItem Content="16 threads" Tag="16" /></ComboBox><ToggleSwitch x:Name="ScsBackground" Header="Lower priority: the PC stays usable, the compile takes longer" OffContent="Off" OnContent="On" Toggled="ScsToggleChanged" /><ToggleSwitch x:Name="ScsCommunity" Header="Use community recordings (needs your SCSKiller account and settings)" OffContent="Off" OnContent="On" Toggled="ScsToggleChanged" /><TextBlock x:Name="ScsToolPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}" /></StackPanel></Expander></StackPanel></Border>
              <Button x:Name="LaunchButton" Content="Launch" Click="LaunchGame" Visibility="Collapsed" /><Button x:Name="RefreshGameButton" Content="Refresh status" Click="RefreshGame" Visibility="Collapsed" />
            </StackPanel></ScrollViewer>
          </Grid>
          <InfoBar x:Name="DriverUpdateNotice" IsOpen="False" IsClosable="False" Severity="Warning" Visibility="Collapsed" />
          <Border x:Name="LegacyLibraryControls" Visibility="Collapsed"><StackPanel><TextBlock x:Name="CurrentCap" /><Border x:Name="GuideCard"><StackPanel><TextBlock x:Name="SetupStage" /><ProgressBar x:Name="SetupProgress" /><TextBlock x:Name="GuideTitle" /><TextBlock x:Name="GuideBody" /><Button x:Name="GuideButton" Click="FollowGameGuide" /></StackPanel></Border><Border x:Name="CapCard"><StackPanel><ComboBox x:Name="CapChoice" SelectionChanged="CapChanged"><ComboBoxItem Content="Default" Tag="512" /><ComboBoxItem Content="1 GB" Tag="1024" /><ComboBoxItem Content="2 GB" Tag="2048" /><ComboBoxItem Content="4 GB" Tag="4096" /><ComboBoxItem Content="8 GB" Tag="8192" /><ComboBoxItem Content="16 GB" Tag="16384" /></ComboBox><VariableSizedWrapGrid x:Name="SizeButtons"><ToggleButton Content="Default" Tag="512" Click="SelectSize" /><ToggleButton Content="1 GB" Tag="1024" Click="SelectSize" /><ToggleButton Content="2 GB" Tag="2048" Click="SelectSize" /><ToggleButton Content="4 GB" Tag="4096" Click="SelectSize" /><ToggleButton Content="8 GB" Tag="8192" Click="SelectSize" /><ToggleButton Content="16 GB" Tag="16384" Click="SelectSize" /></VariableSizedWrapGrid><Button x:Name="ApplyButton" Click="ApplyGame" /><TextBlock x:Name="LimitAvailability" /></StackPanel></Border><StackPanel x:Name="SafetyPanel"><InfoBar x:Name="SafetyNotice" /><TextBlock x:Name="SafetyDetails" /></StackPanel><InfoBar x:Name="GameNotice" /><Expander x:Name="RecoveryExpander"><Button x:Name="LegacyImportButton" /></Expander></StackPanel></Border>
        </Grid>
        <ScrollViewer x:Name="DriverPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760" /></Grid.ColumnDefinitions><StackPanel Spacing="12">
            <InfoBar x:Name="DeveloperPreviewNotice" IsOpen="False" IsClosable="False" Severity="Informational" Title="Preview only" Message="This screen uses fake data. Windows, driver files, and game files are untouched." />
            <StackPanel Spacing="3"><TextBlock Text="Graphics" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Arc Cache checks your Intel driver automatically. Your installed driver stays unchanged." Style="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel>
            <Border x:Name="Step1Card" Style="{StaticResource Card}" Padding="16"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="Step1Mark" Grid.Column="0" Text="1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="8"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Graphics chip check" FontSize="18" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="SupportProgress" Width="16" Height="16" MinWidth="16" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" /><TextBlock x:Name="Step1Result" Text="Checking automatically…" Style="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><HyperlinkButton x:Name="ChipChangeLink" Content="Change" Click="OpenAdvancedChip" Visibility="Collapsed" /><HyperlinkButton x:Name="CheckAgainLink" Content="Check again" Click="InspectDriver" Visibility="Collapsed" /></StackPanel></Grid><StackPanel x:Name="Step1Details" Spacing="8" Visibility="Collapsed"><TextBlock x:Name="DriverSummary" Style="{StaticResource Muted}" TextWrapping="Wrap" /><ComboBox x:Name="GraphicsChoice" DisplayMemberPath="Adapter" SelectionChanged="GraphicsChanged" HorizontalAlignment="Stretch" Visibility="Collapsed" /><Button x:Name="CheckChipButton" Content="Check this chip" Click="CheckSelectedChip" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left" /><Button x:Name="RetryCheckButton" Content="Try again" Click="InspectDriver" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left" /></StackPanel></StackPanel></Grid></Border>
            <Border Style="{StaticResource Card}" Padding="16"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="Step2Mark" Grid.Column="0" Text="2" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="8"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Game-specific settings" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="Step2Result" Text="Waiting for step 1" Style="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel><HyperlinkButton x:Name="WindowsChangeLink" Grid.Column="1" Content="Change" Click="OpenAdvancedRouting" Visibility="Collapsed" /></Grid><StackPanel x:Name="Step2Details" Spacing="8" Visibility="Collapsed"><TextBlock x:Name="RoutingHint" TextWrapping="Wrap" Style="{StaticResource Muted}" /><Button x:Name="EnableRouteButton" Content="Turn on game-specific settings" Click="EnableRouting" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left" /><Button x:Name="RetryWindowsButton" Content="Check setting again" Click="InspectDriver" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left" /><Button x:Name="RestartCheckButton" Content="I restarted Windows — check again" Click="InspectDriver" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left" /><Button x:Name="DisableRouteButton" Content="Turn off game-specific settings…" Click="RestoreRouting" Visibility="Collapsed" HorizontalAlignment="Left" /><TextBlock x:Name="DisableRouteReason" TextWrapping="Wrap" Visibility="Collapsed" /></StackPanel></StackPanel></Grid></Border>
            <Border x:Name="TrialCard" Style="{StaticResource Card}" Padding="16"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="Step3Mark" Grid.Column="0" Text="3" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="8"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Driver copy test" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="Step3Result" Text="Waiting for step 2" Style="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel><HyperlinkButton x:Name="Step3ChangeLink" Grid.Column="1" Content="Test another size" Click="OpenAdvancedTrial" Visibility="Collapsed" /></Grid><StackPanel x:Name="Step3Details" Spacing="8" Visibility="Collapsed"><InfoBar x:Name="DriverWarning" IsOpen="False" IsClosable="False" Severity="Warning" /><TextBlock x:Name="TrialSummary" TextWrapping="Wrap" /><ComboBox x:Name="TrialSizeChoice" Header="Cache size to test" SelectionChanged="TrialSizeChanged" HorizontalAlignment="Left" MinWidth="240" Visibility="Collapsed" /><TextBlock x:Name="TrialSizeReason" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" /><TextBlock x:Name="TrialRamWarning" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" /><ProgressBar x:Name="TrialProgress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Height="5" /><TextBlock x:Name="TrialStage" TextWrapping="Wrap" /><Button x:Name="TrialStopButton" Content="Stop test" Click="StopDriverTrial" Visibility="Collapsed" HorizontalAlignment="Left" /><Button x:Name="TrialButton" Content="Test driver copy" Click="TryDriverPatch" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left" /><HyperlinkButton x:Name="UpdateDriverLink" Content="Open Intel driver downloads" Click="OpenDriverDownloads" Visibility="Collapsed" HorizontalAlignment="Left" Padding="0" Margin="0" /></StackPanel></StackPanel></Grid></Border>
            <Border x:Name="GraphicsFinishCard" Style="{StaticResource Card}" Padding="18" Visibility="Collapsed"><StackPanel Spacing="8"><TextBlock x:Name="GraphicsFinishTitle" Text="Ready. Choose a game." FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="GraphicsFinishSizes" TextWrapping="Wrap" /><TextBlock Text="A passing driver-copy test does not guarantee every game will work. Arc Cache checks each game after setup." Style="{StaticResource Muted}" TextWrapping="Wrap" /><Button x:Name="ChooseGameButton" Content="Choose a game" Click="ChooseGameForTrial" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="16"><Expander x:Name="GraphicsAdvanced" Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12" Margin="0,8,0,0">
              <TextBlock Text="Most people do not need these controls." Style="{StaticResource Muted}" />
              <StackPanel x:Name="DriverCopySection" Spacing="8"><TextBlock Text="Driver copy" FontWeight="SemiBold" /><TextBlock x:Name="DriverCopyStatus" Text="The installed Windows driver stays unchanged." TextWrapping="Wrap" Style="{StaticResource Muted}" /><StackPanel x:Name="TrialFileSelector" Spacing="6" Visibility="Collapsed"><TextBlock Text="Driver file to test" Style="{StaticResource Muted}" /><ComboBox x:Name="TrialFile" DisplayMemberPath="DisplayName" SelectionChanged="TrialFileChanged" HorizontalAlignment="Stretch" /></StackPanel><TextBlock x:Name="DriverCopyActionReason" Text="No separate driver copy is present." Style="{StaticResource Muted}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="DiscardTrialButton" Content="Remove driver copy" Click="DiscardTrialCopy" Visibility="Collapsed" /><Button x:Name="TrialFilesButton" Content="Open test results" Click="OpenTrialResults" Visibility="Collapsed" /></StackPanel></StackPanel>
              <Border x:Name="DriverDetailsSection" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="0,10,0,0"><StackPanel Spacing="8"><TextBlock Text="Driver details" FontWeight="SemiBold" /><TextBlock x:Name="DriverDetailsSummary" Text="Installed files are checked individually before game setup." TextWrapping="Wrap" Style="{StaticResource Muted}" /><TextBlock x:Name="DriverDetails" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></StackPanel></Border>
              <StackPanel x:Name="TrialLogSection" Spacing="8"><TextBlock x:Name="TrialLogTitle" Text="Test log · no entries yet" FontWeight="SemiBold" /><TextBox x:Name="TrialLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="Collapsed" /></StackPanel>
            </StackPanel></Expander></Border>
          </StackPanel></Grid>
        </ScrollViewer>
        <Grid x:Name="ActivityPanel" Visibility="Collapsed" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Recent actions" FontSize="28" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Text="See what happened and why a step stopped. Detailed messages here can help with troubleshooting." Style="{StaticResource Muted}" /><TextBox x:Name="ActivityLog" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Grid>
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760" /></Grid.ColumnDefinitions><StackPanel Spacing="14"><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" /><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="SCSKiller connection" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="ScsPath" Text="Choose the SCSKiller command-line program (scskiller.exe)." TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}" /><Button Content="Choose scskiller.exe…" Click="ChooseScsCli" HorizontalAlignment="Left" /><TextBlock Text="Choose scskiller.exe, not the SCSKiller desktop app. Tasks start only after you confirm them. Results appear on each game's page in My games." Style="{StaticResource Muted}" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Steam library" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Arc Cache reads local installation records. You do not need to sign into launcher accounts here. Add a game (in My games) lets you choose a 64-bit game executable from any launcher." Style="{StaticResource Muted}" /><Button Content="Choose Steam folder…" Click="ChooseSteamFolder" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Game-specific settings" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="SettingsWindowsStatus" Text="Checking the Windows setting…" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="A Windows setting (DevOverrideEnable) that lets a program load graphics files from a folder named after it, such as Game.exe.local, instead of the installed driver. Arc Cache puts each set-up game's driver copy in that folder. The setting applies to the whole PC, but only programs that have such a folder are affected. Changing it needs administrator rights and a Windows restart. Arc Cache saves the previous value so it can put it back." TextWrapping="Wrap" Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SettingsEnableRoute" Content="Turn on game-specific settings…" Click="EnableRouting" Visibility="Collapsed" /><Button x:Name="SettingsDisableRoute" Content="Turn off game-specific settings…" Click="RestoreRouting" Visibility="Collapsed" /><Button Content="Open Graphics" Click="OpenGraphics" /></StackPanel><TextBlock x:Name="SettingsWindowsReason" TextWrapping="Wrap" Visibility="Collapsed" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="On-screen stats" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="A small card over the game: whether its driver copy loaded and how full its cache file is. Needs borderless or windowed mode." TextWrapping="Wrap" Style="{StaticResource Muted}" /><ToggleSwitch x:Name="OverlayAutoStart" Header="Show when a set-up game starts" OffContent="Off" OnContent="On" Toggled="OverlaySettingChanged" /><TextBlock Text="Arc Cache has to be open for this; it can stay minimized." TextWrapping="Wrap" Style="{StaticResource Muted}" /><ComboBox x:Name="OverlayCorner" Header="Position on the game window" MinWidth="220" SelectionChanged="OverlayCornerChanged" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Troubleshooting" FontSize="20" FontWeight="SemiBold" /><ToggleSwitch x:Name="DiagnosticToggle" Header="Save extra troubleshooting details" OffContent="Off" OnContent="On" Toggled="DiagnosticToggled" /><TextBlock Text="Turn this on before repeating a problem. Details stay on this PC and are not uploaded. Files can contain your name and folder paths, so check them before sharing. Extra logs use about 4 MiB at most." TextWrapping="Wrap" Style="{StaticResource Muted}" /><Button Content="Open logs folder" Click="OpenLogs" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Old driver tests" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Each driver test keeps a full copy of the Intel driver (about 1.3 GB). Arc Cache keeps only the newest passing test for each cache size and the tests your set-up games use, and removes older ones after every passing test. Nothing else is reset." TextWrapping="Wrap" Style="{StaticResource Muted}" /><TextBlock x:Name="DriverTestsSize" Text="Measuring driver tests…" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><Button x:Name="CleanupTrialsButton" Content="Review old driver tests" Click="ReviewDriverTestCleanup" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Introduction" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="A short tour of how Arc Cache works." Style="{StaticResource Muted}" /><Button Content="Show introduction" Click="ReplayIntroduction" HorizontalAlignment="Left" /></StackPanel></Border><Border Background="#FF2B1D20" BorderBrush="#FFB84452" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Danger zone" FontSize="20" FontWeight="SemiBold" Foreground="#FFFF7777" /><TextBlock Text="Reset Arc Cache completely" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="This returns configured games to default settings, restores the saved Windows setting, and deletes Arc Cache's saved setups, driver tests, reports, backups, profiles, icons, recent games, manual games and old logs. The current session log is kept. A Windows restart may be needed." TextWrapping="Wrap" /><Button x:Name="ResetArcCacheButton" Content="Reset Arc Cache completely…" Click="ResetArcCache" HorizontalAlignment="Left" Background="#FFB42332" Foreground="White" /></StackPanel></Border></StackPanel></Grid></ScrollViewer>
      </Grid>
    </NavigationView>
    <InfoBar x:Name="GlobalNotice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning" />
    <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="24,10"><Grid><StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" /><TextBlock x:Name="FooterStatus" Text="" FontSize="12" Style="{StaticResource Muted}" /></StackPanel><TextBlock Text="Game files change only after confirmation" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource Muted}" /></Grid></Border>
    <Grid x:Name="WelcomePanel" Grid.RowSpan="4" Background="#EE202020" Visibility="Collapsed" Padding="28">
      <Border Style="{StaticResource Card}" Background="#FF2D2D2D" MaxWidth="690" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
        <StackPanel Spacing="16">
          <TextBlock Text="WELCOME TO ARC CACHE" CharacterSpacing="120" Style="{StaticResource Muted}" />
          <TextBlock x:Name="WelcomeCount" Text="HOW IT WORKS" Style="{StaticResource Muted}" />
          <TextBlock x:Name="WelcomeTitle" Text="Set up your first game" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="WelcomeBody" Text="Games save graphics they have already prepared in a shader cache. Arc Cache can give a game its own copy of Intel's graphics files and set that game's cache limit. Your installed driver files stay as they are." FontSize="15" TextWrapping="Wrap" />
          <Border x:Name="WelcomePointsBox" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16"><StackPanel x:Name="WelcomePoints" Spacing="10" /></Border>
          <TextBlock x:Name="WelcomeNote" TextWrapping="Wrap" Style="{StaticResource Muted}" />
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="WelcomeBack" Content="Back" Click="IntroductionBack" Visibility="Collapsed" /><Button Content="Not now" Click="IntroductionSkip" /></StackPanel>
            <Button x:Name="WelcomeNext" Content="Go to Arc Cache" Click="IntroductionNext" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
