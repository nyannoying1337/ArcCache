<Window x:Class="ArcCache.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:ArcCache.Core" xmlns:local="using:ArcCache" Title="Arc Cache · Steam library">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" RequestedTheme="Dark"><Grid.Resources><local:ArtworkConverter x:Key="ArtworkConverter" /></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="TitleArea" Padding="22,0,150,0"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Text="ARC CACHE" FontWeight="SemiBold" CharacterSpacing="160" /><TextBlock Text="Steam edition · preview" Style="{StaticResource Muted}" /></StackPanel></Grid>
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True" OpenPaneLength="200" SelectionChanged="Navigate">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="LibraryNav" Content="Your games" Tag="Library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Graphics" Tag="Driver"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Recent actions" Tag="Activity"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems><NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
      <Grid Padding="28,18,28,20">
        <Grid x:Name="LibraryPanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,20"><StackPanel Spacing="6"><TextBlock Text="Your games" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="Choose a game, set it up, then pick a cache size to try." Style="{StaticResource Muted}" /></StackPanel><Button Content="Refresh Steam" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshLibrary" /></Grid>
          <InfoBar x:Name="LibraryNotice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,14" />
          <Grid x:Name="LibraryColumns" Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <AutoSuggestBox x:Name="Search" PlaceholderText="Search installed games" TextChanged="SearchChanged"><AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon></AutoSuggestBox>
              <ListView x:Name="GamesList" Grid.Row="1" SelectionChanged="GameSelected" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate><DataTemplate x:DataType="core:SteamGame"><Grid Padding="8,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Width="40" Height="40"><Grid><FontIcon Glyph="&#xE7FC;" FontSize="18" /><Image Source="{Binding IconSources, Converter={StaticResource ArtworkConverter}}" Stretch="UniformToFill" /></Grid></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{x:Bind SupportLabel}" FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
              </ListView>
              <TextBlock x:Name="LibraryCount" Grid.Row="2" Text="Reading Steam libraries…" FontSize="12" Style="{StaticResource Muted}" />
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" Spacing="16">
              <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Height="148"><Grid><FontIcon x:Name="GamePlaceholder" Glyph="&#xE7FC;" FontSize="42" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Image x:Name="GameArtwork" Stretch="UniformToFill" ImageOpened="ArtworkOpened" ImageFailed="ArtworkFailed" /></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9"><TextBlock Text="STEAM LIBRARY" FontSize="11" CharacterSpacing="150" Style="{StaticResource Muted}" /><TextBlock x:Name="GameTitle" Text="Choose a game" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="GameStatus" Text="Games use your normal graphics driver until you set them up here." Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="LaunchButton" Content="Play through Steam" Click="LaunchGame" IsEnabled="False" /><Button Content="Check setup" Click="RefreshGame" /></StackPanel></StackPanel></Grid></Border>
              <InfoBar x:Name="GameNotice" IsOpen="True" IsClosable="False" Severity="Informational" Title="Start the game first" Message="Start this game in DirectX 12 mode and leave it at the menu. Arc Cache will find the files it needs." />
              <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Your next step" Style="{StaticResource Muted}" /><TextBlock x:Name="GuideTitle" Text="Choose a game to get started" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="GuideBody" TextWrapping="Wrap" /><Button x:Name="GuideButton" Content="Get started" Click="FollowGameGuide" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Border><StackPanel x:Name="SafetyPanel" Visibility="Collapsed" Spacing="4"><InfoBar x:Name="SafetyNotice" IsOpen="False" IsClosable="False" /><Expander Header="Why this warning?" HorizontalAlignment="Stretch"><TextBlock x:Name="SafetyDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}" /></Expander></StackPanel><Border x:Name="CapCard" Style="{StaticResource Card}"><StackPanel Spacing="15"><Grid><TextBlock Text="Choose a cache size" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="CurrentCap" Text="No private setup" Visibility="Collapsed" Style="{StaticResource Muted}" /></Grid><TextBlock Text="The shader cache saves work already done to prepare graphics. Choose a larger limit to try; other games keep their normal driver." Style="{StaticResource Muted}" /><ComboBox x:Name="CapChoice" SelectionChanged="CapChanged" SelectedIndex="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="512 MiB · default size" Tag="512" /><ComboBoxItem Content="1 GiB" Tag="1024" /><ComboBoxItem Content="2 GiB · test option" Tag="2048" /><ComboBoxItem Content="4 GiB · test option" Tag="4096" /></ComboBox><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ApplyButton" Content="Apply to this game" Style="{StaticResource AccentButtonStyle}" Click="ApplyGame" IsEnabled="False" /><Button x:Name="RestoreButton" Content="Use default settings" Click="RestoreGame" IsEnabled="False" /></StackPanel><TextBlock Text="Larger settings are test options. Improvements in games have not been measured." FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Check the running game" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Start the game in DirectX 12 mode, then check whether its setup files were loaded." Style="{StaticResource Muted}" /><Expander Header="Game check details"><TextBlock x:Name="RuntimeDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /></Expander><TextBlock x:Name="RuntimeStatus" Text="Game setup has not been checked yet." TextWrapping="Wrap" IsTextSelectionEnabled="True" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Check game setup" Click="ObserveGame" /><Button x:Name="MonitorButton" Content="Show on-screen stats" Click="ToggleCacheMonitor" /></StackPanel><Expander x:Name="RecoveryExpander" Header="Fix a setup or view details" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><Button x:Name="ImportButton" Content="Open a saved setup record…" Click="ImportSetup" /><TextBlock x:Name="GameDetails" Text="Select a game to see its folders and saved setup record." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /></StackPanel></Expander></StackPanel></Border>
<Expander Header="Prepare shaders with SCSKiller (optional)" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock x:Name="ScsSummary" Text="SCSKiller prepares shaders before you play. It currently uses the normal driver, not your custom cache size." Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ScsStatusButton" Content="Check available shaders" Click="ScsStatus" /><Button x:Name="ScsCompileButton" Content="Prepare shaders…" Click="ScsCompile" /><Button x:Name="ScsCancelButton" Content="Stop SCSKiller task" Click="CancelScs" Visibility="Collapsed" /></StackPanel><TextBlock Text="Community downloads need your existing SCSKiller account and settings. Connect its command-line program in Settings." FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Expander>            </StackPanel></ScrollViewer>
          </Grid>
        </Grid>
        <ScrollViewer x:Name="DriverPanel" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Left"><TextBlock Text="Your Intel graphics" FontSize="32" FontWeight="SemiBold" /><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Intel graphics chip" FontWeight="SemiBold" /><ComboBox x:Name="GraphicsChoice" DisplayMemberPath="Adapter" SelectionChanged="GraphicsChanged" HorizontalAlignment="Stretch" /><TextBlock Text="Built-in Intel graphics are included. Choose the chip your game uses. This selection does not switch the game to a different chip." TextWrapping="Wrap" Style="{StaticResource Muted}" /><TextBlock x:Name="DriverTitle" Text="Checking your graphics software…" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="DriverSummary" Style="{StaticResource Muted}" /><Button Content="Check support" Click="InspectDriver" HorizontalAlignment="Left" /><Expander Header="Support details (advanced)" HorizontalAlignment="Stretch"><TextBlock x:Name="DriverDetails" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Expander></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Try a separate test copy" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Start with a separate graphics check. If it passes, choose a game and follow its setup guide. Your installed driver stays the same. Changes to a game require your confirmation." Style="{StaticResource Muted}" /><ComboBox x:Name="TrialFile" DisplayMemberPath="DisplayName" SelectionChanged="TrialFileChanged" HorizontalAlignment="Stretch" /><Button x:Name="UseTrialButton" Content="Choose a game and use this copy" Click="ChooseGameForTrial" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Visibility="Collapsed" /><Button x:Name="TrialButton" Content="Try patching…" Click="TryDriverPatch" IsEnabled="False" HorizontalAlignment="Left" /><TextBlock x:Name="TrialSummary" Text="Choose Check support to see whether a separate test is available." TextWrapping="Wrap" /><ProgressBar x:Name="TrialProgress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" /><TextBlock x:Name="TrialStage" TextWrapping="Wrap" /><Expander x:Name="TrialLogExpander" Header="Progress log" HorizontalAlignment="Stretch" IsExpanded="False"><TextBox x:Name="TrialLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Expander><Button Content="Remove a test copy…" Click="DiscardTrialCopy" HorizontalAlignment="Left" /><Button x:Name="TrialFilesButton" Content="Open test results" Click="OpenTrialResults" IsEnabled="False" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Memory and cache" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="GraphicsRam" Text="PC RAM: not checked yet" FontSize="18" /><TextBlock x:Name="GraphicsCache" Text="Intel cache on disk: not checked yet" FontSize="18" /><TextBlock x:Name="GraphicsStatsStatus" TextWrapping="Wrap" Style="{StaticResource Muted}" /><TextBlock Text="RAM shows memory used by the whole PC, not just shaders. The disk cache is shared by Intel apps and games. Shader-cache RAM usage cannot currently be measured." Style="{StaticResource Muted}" /><Button Content="Refresh statistics" Click="RefreshGraphicsStats" HorizontalAlignment="Left" /></StackPanel></Border><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Windows keeps its normal driver" Message="Arc Cache uses separate copies. It does not replace Windows driver files. If the installed driver needs repair, use Intel’s official installer." /></StackPanel></ScrollViewer>
        <Grid x:Name="ActivityPanel" Visibility="Collapsed" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Recent actions" FontSize="32" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Text="See what happened and why a step stopped. Detailed messages here can help with troubleshooting." Style="{StaticResource Muted}" /><TextBox x:Name="ActivityLog" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Grid>
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Left"><TextBlock Text="Settings" FontSize="32" FontWeight="SemiBold" /><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="SCSKiller connection" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="ScsPath" Text="Choose the SCSKiller command-line program (scskiller.exe)." TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}" /><Button Content="Choose scskiller.exe…" Click="ChooseScsCli" HorizontalAlignment="Left" /><TextBlock Text="Choose scskiller.exe, not the SCSKiller desktop app. Tasks start only after you confirm them; results appear in Recent actions." Style="{StaticResource Muted}" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Steam library" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Arc Cache reads games already installed on this PC. You do not need to sign in to Steam here." Style="{StaticResource Muted}" /><Button Content="Choose Steam folder…" Click="ChooseSteamFolder" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Enable game-specific settings" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="OverrideStatus" Text="Checking whether game-specific settings are enabled…" Style="{StaticResource Muted}" /><TextBlock Text="This lets a game use its own graphics-driver copy. Turn it on once and restart Windows. Other games keep using the normal driver unless they also have their own copies." TextWrapping="Wrap" Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Enable game-specific settings…" Click="EnableRouting" /><Button Content="Undo the Windows setting…" Click="RestoreRouting" /></StackPanel><TextBlock Text="To undo one game, choose Use default settings on its page. Leave this Windows setting alone if other games still use custom copies." TextWrapping="Wrap" Style="{StaticResource Muted}" /><Expander Header="What changes in Windows?"><TextBlock Text="DevOverrideEnable lets Windows respect .exe.local DLL redirection even for apps with a manifest. It is machine-wide and can affect other apps with .local setups. It does not replace the installed driver or turn off signature/integrity enforcement. Enable or restore requires manually running this app as administrator, confirmation, and a Windows restart. Restore uses the saved previous value; remove private game setups first." TextWrapping="Wrap" /></Expander></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Troubleshooting" FontSize="20" FontWeight="SemiBold" /><ToggleSwitch x:Name="DiagnosticToggle" Header="Save extra troubleshooting details" OffContent="Off" OnContent="On" Toggled="DiagnosticToggled" /><TextBlock Text="Turn this on before repeating a problem. Details stay on this PC and are not uploaded. Files can contain your name and folder paths, so check them before sharing. Extra logs use about 4 MiB at most." TextWrapping="Wrap" Style="{StaticResource Muted}" /><Button Content="Open logs folder" Click="OpenLogs" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Preview version" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="This is a test version. Only checked driver files can be changed. Multiplayer and anti-cheat compatibility are not guaranteed." Style="{StaticResource Muted}" /></StackPanel></Border></StackPanel></ScrollViewer>
      </Grid>
    </NavigationView>
    <InfoBar x:Name="GlobalNotice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning" />
    <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="24,10"><Grid><StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" /><TextBlock x:Name="FooterStatus" Text="Ready · no background game or system changes" FontSize="12" Style="{StaticResource Muted}" /></StackPanel><TextBlock Text="Game files change only after confirmation" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource Muted}" /></Grid></Border>
  </Grid>
</Window>
