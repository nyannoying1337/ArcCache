<Window x:Class="ArcCache.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:ArcCache.Core" xmlns:local="using:ArcCache" Title="Arc Cache">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" RequestedTheme="Dark"><Grid.Resources><local:ArtworkConverter x:Key="ArtworkConverter" /></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="TitleArea" Padding="22,0,150,0"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Text="ARC CACHE" FontWeight="SemiBold" CharacterSpacing="160" /><TextBlock Text="Preview · per-game shader cache" Style="{StaticResource Muted}" /></StackPanel></Grid>
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="206" SelectionChanged="Navigate">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="HomeNav" Content="Home" Tag="Home"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="LibraryNav" Content="My games" Tag="Library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Graphics" Tag="Driver"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Recent actions" Tag="Activity"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems><NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
      <Grid Padding="22,16,22,18">
        <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="20" HorizontalAlignment="Stretch">
            <Grid>
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="HomeGreeting" Text="Good to go" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="HomeWelcomeText" Text="Your graphics are ready. Pick a game to get started." Style="{StaticResource Muted}" />
              </StackPanel>
              <Button Content="Settings" Click="OpenSettings" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border x:Name="HomeSetupCard" Style="{StaticResource Card}" Background="#FF18382C" BorderBrush="#FF285A43" BorderThickness="1" Padding="22">
              <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="6" VerticalAlignment="Center">
                  <TextBlock x:Name="HomeSetupLabel" Text="CHECKING SETUP" FontSize="12" FontWeight="SemiBold" CharacterSpacing="100" Foreground="#FF7FE1AE" />
                  <TextBlock x:Name="HomeSetupTitle" Text="Checking your graphics" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="HomeSetupDetails" Text="Arc Cache is checking your Intel graphics and Windows setting." Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="HomeSetupButton" Grid.Column="1" Content="Set up a game" Click="HomeSetupAction" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="Pick up where you left off" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="View all games" Click="OpenLibrary" HorizontalAlignment="Right" />
              </Grid>
              <StackPanel x:Name="HomeRecentGames" Spacing="8" />
              <TextBlock x:Name="HomeEmptyGames" Text="No games found yet. Refresh your library or add a game to get started." Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Spacing="10">
              <Grid>
                <TextBlock Text="Graphics" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="View details" Click="OpenGraphics" HorizontalAlignment="Right" />
              </Grid>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Intel graphics" FontSize="12" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="HomeGraphicsModel" Text="Checking graphics…" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="HomeGraphicsDriver" Text="Driver not checked yet" FontSize="12" Style="{StaticResource Muted}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Game-specific setting" FontSize="12" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="HomeRoutingStatus" Text="Checking…" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="HomeRoutingDetails" Text="Windows setting status" FontSize="12" Style="{StaticResource Muted}" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="Driver checks, help and cache measurements are under Graphics." Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LibraryPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,14"><StackPanel Spacing="6"><TextBlock Text="Your games" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Choose a game, set it up, then pick a cache size to try." Style="{StaticResource Muted}" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Add game…" Click="AddManualGame" /><Button Content="Refresh games" Click="RefreshLibrary" /></StackPanel></Grid>
          <InfoBar x:Name="DriverUpdateNotice" IsOpen="False" IsClosable="False" Severity="Warning"><InfoBar.ActionButton><Button Content="Check support" Click="InspectDriver" /></InfoBar.ActionButton></InfoBar>
          <InfoBar x:Name="LibraryNotice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,14" />
          <Grid x:Name="LibraryColumns" Grid.Row="2" ColumnSpacing="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="292" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <AutoSuggestBox x:Name="Search" PlaceholderText="Search installed games" TextChanged="SearchChanged"><AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon></AutoSuggestBox>
              <ComboBox x:Name="SourceFilter" Grid.Row="1" HorizontalAlignment="Stretch" SelectionChanged="SourceChanged" /><ListView x:Name="GamesList" Grid.Row="2" SelectionChanged="GameSelected" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate><DataTemplate x:DataType="core:SteamGame"><Grid Padding="8,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Width="40" Height="40"><Grid><FontIcon Glyph="&#xE7FC;" FontSize="18" /><Image Source="{Binding IconSources, Converter={StaticResource ArtworkConverter}}" Stretch="UniformToFill" /></Grid></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{x:Bind SupportLabel}" FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
              </ListView>
              <TextBlock x:Name="LibraryCount" Grid.Row="3" Text="Reading game libraries…" FontSize="12" Style="{StaticResource Muted}" />
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" Spacing="12">
              <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Height="148"><Grid><FontIcon x:Name="GamePlaceholder" Glyph="&#xE7FC;" FontSize="42" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Image x:Name="GameArtwork" Stretch="UniformToFill" ImageOpened="ArtworkOpened" ImageFailed="ArtworkFailed" /></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9"><TextBlock x:Name="GameSource" Text="GAME LIBRARY" FontSize="11" CharacterSpacing="150" Style="{StaticResource Muted}" /><TextBlock x:Name="GameTitle" Text="Choose a game" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="GameStatus" Text="Games use your normal graphics driver until you set them up here." Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="LaunchButton" Content="Play through Steam" Click="LaunchGame" IsEnabled="False" /><Button Content="Refresh status" Click="RefreshGame" /></StackPanel></StackPanel></Grid></Border>
              <InfoBar x:Name="GameNotice" IsOpen="True" IsClosable="False" Severity="Informational" Title="Start the game first" Message="If the game offers DirectX 12, choose it. Leave the game at the main menu and keep Arc Cache open so it can find the game files." />
              <Border x:Name="GuideCard" Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock x:Name="SetupStage" Text="Game setup" Style="{StaticResource Muted}" /><ProgressBar x:Name="SetupProgress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Height="5" /><TextBlock x:Name="GuideTitle" Text="Choose a game to get started" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="GuideBody" TextWrapping="Wrap" /><Button x:Name="GuideButton" Content="Get started" Click="FollowGameGuide" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /></StackPanel></Border><StackPanel x:Name="SafetyPanel" Visibility="Collapsed" Spacing="4"><InfoBar x:Name="SafetyNotice" IsOpen="False" IsClosable="False" /><Expander Header="Why this warning?" HorizontalAlignment="Stretch"><TextBlock x:Name="SafetyDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}" /></Expander></StackPanel><Border x:Name="CapCard" Style="{StaticResource Card}"><StackPanel Spacing="15"><Grid><TextBlock Text="Choose a cache size" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="CurrentCap" Text="No game-specific setup" Visibility="Collapsed" Style="{StaticResource Muted}" /></Grid><TextBlock Text="Games save graphics they have already prepared in a shader cache. A larger limit gives that saved data more room. Other games keep using their usual driver files." Style="{StaticResource Muted}" /><ComboBox x:Name="CapChoice" SelectionChanged="CapChanged" SelectedIndex="1" HorizontalAlignment="Stretch" Visibility="Collapsed"><ComboBoxItem Content="512 MB · default size" Tag="512" /><ComboBoxItem Content="1 GB" Tag="1024" /><ComboBoxItem Content="2 GB · test option" Tag="2048" /><ComboBoxItem Content="4 GB · test option" Tag="4096" /><ComboBoxItem Content="8 GB · test option" Tag="8192" /><ComboBoxItem Content="16 GB · needs lots of memory" Tag="16384" /></ComboBox><VariableSizedWrapGrid x:Name="SizeButtons" Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="90" ItemHeight="46"><ToggleButton Content="Default" Tag="512" Click="SelectSize" Margin="0,0,6,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ToggleButton Content="1 GB" Tag="1024" Click="SelectSize" Margin="0,0,6,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ToggleButton Content="2 GB" Tag="2048" Click="SelectSize" Margin="0,0,6,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ToggleButton Content="4 GB" Tag="4096" Click="SelectSize" Margin="0,0,6,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ToggleButton Content="8 GB" Tag="8192" Click="SelectSize" Margin="0,0,6,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ToggleButton Content="16 GB" Tag="16384" Click="SelectSize" Margin="0,0,6,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /></VariableSizedWrapGrid><TextBlock x:Name="LimitAvailability" TextWrapping="Wrap" Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ApplyButton" Content="Apply to this game" Style="{StaticResource AccentButtonStyle}" Click="ApplyGame" IsEnabled="False" /><Button x:Name="RemoveManualButton" Content="Remove from library" Click="RemoveManualGame" Visibility="Collapsed" /><Button x:Name="RestoreButton" Content="Use default settings" Click="RestoreGame" IsEnabled="False" /></StackPanel><TextBlock Text="Larger sizes can use more disk space and memory. We have not measured whether this improves games." FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Check what the game loaded" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Start the game in DirectX 12, then check which Intel graphics files it used." Style="{StaticResource Muted}" /><Expander Header="Technical check details"><TextBlock x:Name="RuntimeDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /></Expander><TextBlock x:Name="RuntimeStatus" Text="Arc Cache has not checked which graphics files the game used yet." TextWrapping="Wrap" IsTextSelectionEnabled="True" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Check loaded driver" Click="ObserveGame" /><Button x:Name="MonitorButton" Content="Show on-screen stats" Click="ToggleCacheMonitor" /></StackPanel><Expander x:Name="RecoveryExpander" Header="Fix a setup or view details" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><Button x:Name="ImportButton" Content="Open a saved setup record…" Click="ImportSetup" /><TextBlock x:Name="GameDetails" Text="Select a game to see its folders and saved setup record." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /></StackPanel></Expander></StackPanel></Border>
<Expander Header="Prepare shaders with SCSKiller (optional)" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock x:Name="ScsSummary" Text="SCSKiller prepares shaders before you play. It currently uses the normal driver, not your custom cache size." Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ScsStatusButton" Content="Check available shaders" Click="ScsStatus" /><Button x:Name="ScsCompileButton" Content="Prepare shaders…" Click="ScsCompile" /><Button x:Name="ScsCancelButton" Content="Stop SCSKiller task" Click="CancelScs" Visibility="Collapsed" /></StackPanel><TextBlock Text="Community downloads need your existing SCSKiller account and settings. Connect its command-line program in Settings." FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Expander>            </StackPanel></ScrollViewer>
          </Grid>
        </Grid>
        <ScrollViewer x:Name="DriverPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
          <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
              <TextBlock Text="Graphics" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Do the checks here before setting up a game. Arc Cache leaves your installed Intel driver alone." Style="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="20">
              <StackPanel Spacing="14">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="6">
                    <TextBlock Text="STEP 1 · INTEL GRAPHICS" FontSize="12" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DriverTitle" Text="Checking your graphics software…" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DriverSummary" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing x:Name="SupportProgress" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                    <Button Content="Check support" Click="InspectDriver" Style="{StaticResource AccentButtonStyle}" />
                  </StackPanel>
                </Grid>
                <Expander Header="Choose a different Intel graphics chip">
                  <StackPanel Spacing="8" Margin="0,8,0,0">
                    <ComboBox x:Name="GraphicsChoice" DisplayMemberPath="Adapter" SelectionChanged="GraphicsChanged" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Only changes which Intel chip Arc Cache checks. Windows still chooses which graphics chip each game uses." TextWrapping="Wrap" Style="{StaticResource Muted}" />
                  </StackPanel>
                </Expander>
                <Expander Header="Technical driver details">
                  <TextBlock x:Name="DriverDetails" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </Expander>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                  <TextBlock Text="STEP 2 · WINDOWS SETTING" FontSize="12" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                  <TextBlock Text="Game-specific settings" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock x:Name="OverrideStatus" Text="Checking whether game-specific settings are enabled…" FontWeight="SemiBold" />
                  <TextBlock Text="This lets prepared games use their own Intel graphics files. Other games keep using the usual driver." TextWrapping="Wrap" Style="{StaticResource Muted}" />
                  <TextBlock x:Name="RoutingHint" Text="Check graphics support first. This setting is only needed when you set up a game-specific copy." TextWrapping="Wrap" Style="{StaticResource Muted}" />
                  <Expander Header="Why does Arc Cache need this?">
                    <TextBlock Margin="0,8,0,0" Text="Windows controls whether an app can use the separate files prepared for a game. This setting applies to the PC and needs a restart. Arc Cache asks before changing it and can restore the previous setting. Windows security checks stay on." TextWrapping="Wrap" />
                  </Expander>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <Button x:Name="EnableRouteButton" Content="Turn on game settings…" Click="EnableRouting" IsEnabled="False" />
                  <Button x:Name="RestoreRouteButton" Content="Restore previous setting…" Click="RestoreRouting" IsEnabled="False" />
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="TrialCard" Style="{StaticResource Card}" Padding="20" Visibility="Collapsed">
              <StackPanel Spacing="12">
                <TextBlock Text="TRY A SEPARATE DRIVER COPY" FontSize="12" FontWeight="SemiBold" CharacterSpacing="90" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="This graphics driver is not on Arc Cache’s checked list" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="You can test a separate copy before choosing a game. This does not replace your installed driver or guarantee that a game will work." TextWrapping="Wrap" Style="{StaticResource Muted}" />
                <ComboBox x:Name="TrialFile" Header="Intel graphics file to test" DisplayMemberPath="DisplayName" SelectionChanged="TrialFileChanged" HorizontalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="TrialButton" Content="Test separate copy…" Click="TryDriverPatch" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                  <Button x:Name="UseTrialButton" Content="Choose a game and use this copy" Click="ChooseGameForTrial" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="TrialSummary" Text="Check support to see whether this driver can be tested." TextWrapping="Wrap" />
                <ProgressBar x:Name="TrialProgress" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                <TextBlock x:Name="TrialStage" TextWrapping="Wrap" />
                <Expander x:Name="TrialLogExpander" Header="Progress and details"><TextBox x:Name="TrialLog" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Expander>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Remove a test copy…" Click="DiscardTrialCopy" /><Button x:Name="TrialFilesButton" Content="Open test results" Click="OpenTrialResults" IsEnabled="False" /></StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="4"><TextBlock Text="Your PC right now" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="A quick view of PC memory and the shared Intel cache." Style="{StaticResource Muted}" /></StackPanel>
                  <Button Grid.Column="1" Content="Refresh" Click="RefreshGraphicsStats" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14"><StackPanel Spacing="4"><TextBlock Text="PC memory" FontSize="12" Style="{StaticResource Muted}" /><TextBlock x:Name="GraphicsRam" Text="Not checked yet" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14"><StackPanel Spacing="4"><TextBlock Text="Intel cache on disk" FontSize="12" Style="{StaticResource Muted}" /><TextBlock x:Name="GraphicsCache" Text="Not checked yet" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                </Grid>
                <TextBlock x:Name="GraphicsStatsStatus" Text="The cache is shared by Intel apps and games. Per-game cache growth is not measured here." TextWrapping="Wrap" Style="{StaticResource Muted}" />
              </StackPanel>
            </Border>
            <Expander Header="More tools (advanced)">
              <StackPanel Spacing="14" Margin="0,10,0,0">
                <Expander Header="Check other Intel driver files">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <TextBlock Text="These checks are for driver files that are not part of the regular game setup." TextWrapping="Wrap" Style="{StaticResource Muted}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Choose a driver file…" Click="ScanExperimentalDll" /><Button Content="Check installed test file" Click="ScanInstalledXe3" /></StackPanel>
                    <TextBlock x:Name="ExperimentSummary" Text="No changes are made during this check." TextWrapping="Wrap" />
                    <Expander Header="Check details"><TextBlock x:Name="ExperimentDetails" Margin="0,8,0,0" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /></Expander>
                    <ComboBox x:Name="Xe3Cap" Header="Cache size for the test copy" SelectedIndex="0"><ComboBoxItem Content="512 MB · unchanged copy" Tag="512" /><ComboBoxItem Content="1 GB" Tag="1024" /><ComboBoxItem Content="2 GB" Tag="2048" /><ComboBoxItem Content="4 GB" Tag="4096" /></ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="Xe3Prepare" Content="Create test copy…" Click="PrepareXe3" IsEnabled="False" /><Button x:Name="Xe3Run" Content="Run graphics check…" Click="RunXe3" IsEnabled="False" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open saved test…" Click="OpenXe3Receipt" /><Button x:Name="Xe3Folder" Content="Open test files" Click="OpenXe3Folder" IsEnabled="False" /></StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="ActivityPanel" Visibility="Collapsed" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Recent actions" FontSize="28" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Text="See what happened and why a step stopped. Detailed messages here can help with troubleshooting." Style="{StaticResource Muted}" /><TextBox x:Name="ActivityLog" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Grid>
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"><StackPanel Spacing="14" MaxWidth="1120" HorizontalAlignment="Stretch"><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" /><Button Content="Show introduction" Click="ReplayIntroduction" HorizontalAlignment="Left" /><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="SCSKiller connection" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="ScsPath" Text="Choose the SCSKiller command-line program (scskiller.exe)." TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}" /><Button Content="Choose scskiller.exe…" Click="ChooseScsCli" HorizontalAlignment="Left" /><TextBlock Text="Choose scskiller.exe, not the SCSKiller desktop app. Tasks start only after you confirm them; results appear in Recent actions." Style="{StaticResource Muted}" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Steam library" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Arc Cache reads local installation records. You do not need to sign into launcher accounts here. Add game lets you select a 64-bit game executable from any launcher." Style="{StaticResource Muted}" /><Button Content="Choose Steam folder…" Click="ChooseSteamFolder" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Windows graphics setting" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Its status and controls are on the Graphics page, beside the driver check." TextWrapping="Wrap" Style="{StaticResource Muted}" /><Button Content="Open Graphics" Click="OpenGraphics" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Troubleshooting" FontSize="20" FontWeight="SemiBold" /><ToggleSwitch x:Name="DiagnosticToggle" Header="Save extra troubleshooting details" OffContent="Off" OnContent="On" Toggled="DiagnosticToggled" /><TextBlock Text="Turn this on before repeating a problem. Details stay on this PC and are not uploaded. Files can contain your name and folder paths, so check them before sharing. Extra logs use about 4 MiB at most." TextWrapping="Wrap" Style="{StaticResource Muted}" /><Button Content="Open logs folder" Click="OpenLogs" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Preview version" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="This is a test version. Only checked driver files can be changed. Multiplayer and anti-cheat compatibility are not guaranteed." Style="{StaticResource Muted}" /></StackPanel></Border></StackPanel></ScrollViewer>
      </Grid>
    </NavigationView>
    <InfoBar x:Name="GlobalNotice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning" />
    <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="24,10"><Grid><StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" /><TextBlock x:Name="FooterStatus" Text="Ready · no background game or system changes" FontSize="12" Style="{StaticResource Muted}" /></StackPanel><TextBlock Text="Game files change only after confirmation" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource Muted}" /></Grid></Border>
    <Grid x:Name="WelcomePanel" Grid.RowSpan="4" Background="#EE202020" Visibility="Collapsed" Padding="28">
      <Border Style="{StaticResource Card}" Background="#FF2D2D2D" MaxWidth="690" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
        <StackPanel Spacing="16">
          <TextBlock Text="WELCOME TO ARC CACHE" CharacterSpacing="120" Style="{StaticResource Muted}" />
          <TextBlock x:Name="WelcomeCount" Text="HOW IT WORKS" Style="{StaticResource Muted}" />
          <TextBlock x:Name="WelcomeTitle" Text="Set up your first game" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="WelcomeBody" Text="Games save graphics they have already prepared in a shader cache. Arc Cache can give a game its own copy of Intel's graphics files and set that game's cache limit. Your installed driver files stay as they are." FontSize="15" TextWrapping="Wrap" />
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="1  Check whether your Intel driver is supported" FontWeight="SemiBold" />
              <TextBlock Text="2  If asked, allow the Windows setting and restart your PC" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="3  Start the game once so Arc Cache can find it, then close it" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="4  Set up the separate graphics files, then start the game again for a check" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="5  Close the game and choose a cache size" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <TextBlock Text="The Windows setting affects the whole PC and needs your approval and a restart. Arc Cache explains it before asking. You can return any game to its usual driver at any time." TextWrapping="Wrap" Style="{StaticResource Muted}" />
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="WelcomeBack" Content="Back" Click="IntroductionBack" Visibility="Collapsed" /><Button Content="Not now" Click="IntroductionSkip" /></StackPanel>
            <Button x:Name="WelcomeNext" Content="Go to Arc Cache" Click="IntroductionNext" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
