<Window x:Class="ArcCache.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:ArcCache.Core" xmlns:local="using:ArcCache" Title="Arc Cache · Experimental">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root" RequestedTheme="Dark"><Grid.Resources><local:ArtworkConverter x:Key="ArtworkConverter" /></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid x:Name="TitleArea" Padding="22,0,150,0"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><FontIcon Glyph="&#xE945;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Text="ARC CACHE" FontWeight="SemiBold" CharacterSpacing="160" /><TextBlock Text="Experimental · larger cache test" Style="{StaticResource Muted}" /></StackPanel></Grid>
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True" OpenPaneLength="200" SelectionChanged="Navigate">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="LibraryNav" Content="Your games" Tag="Library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Driver" Tag="Driver"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="Activity" Tag="Activity"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems><NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
      <Grid Padding="28,18,28,20">
        <Grid x:Name="LibraryPanel">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="0,0,0,20"><StackPanel Spacing="6"><TextBlock Text="Your games" FontSize="32" FontWeight="SemiBold" /><TextBlock Text="Choose a game. Prepare its private driver. Apply a cache limit." Style="{StaticResource Muted}" /></StackPanel><Button Content="Refresh Steam" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshLibrary" /></Grid>
          <InfoBar x:Name="DriverUpdateNotice" IsOpen="False" IsClosable="False" Severity="Warning"><InfoBar.ActionButton><Button Content="Check new DLLs" Click="InspectDriver" /></InfoBar.ActionButton></InfoBar>
          <InfoBar x:Name="LibraryNotice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,14" />
          <Grid x:Name="LibraryColumns" Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <AutoSuggestBox x:Name="Search" PlaceholderText="Search installed games" TextChanged="SearchChanged"><AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon></AutoSuggestBox>
              <ListView x:Name="GamesList" Grid.Row="1" SelectionChanged="GameSelected" SelectionMode="Single" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate><DataTemplate x:DataType="core:SteamGame"><Grid Padding="8,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Width="40" Height="40"><Grid><FontIcon Glyph="&#xE7FC;" FontSize="18" /><Image Source="{Binding IconSources, Converter={StaticResource ArtworkConverter}}" Stretch="UniformToFill" /></Grid></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{x:Bind SupportLabel}" FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
              </ListView>
              <TextBlock x:Name="LibraryCount" Grid.Row="2" Text="Reading Steam libraries…" FontSize="12" Style="{StaticResource Muted}" />
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details" Spacing="16">
              <Border Style="{StaticResource Card}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Height="148"><Grid><FontIcon x:Name="GamePlaceholder" Glyph="&#xE7FC;" FontSize="42" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><Image x:Name="GameArtwork" Stretch="UniformToFill" ImageOpened="ArtworkOpened" ImageFailed="ArtworkFailed" /></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="9"><TextBlock Text="STEAM LIBRARY" FontSize="11" CharacterSpacing="150" Style="{StaticResource Muted}" /><TextBlock x:Name="GameTitle" Text="Choose a game" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="GameStatus" Text="Your installed library stays on the original driver unless you explicitly configure a supported game." Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="LaunchButton" Content="Play through Steam" Click="LaunchGame" IsEnabled="False" /><Button Content="Refresh setup" Click="RefreshGame" /></StackPanel></StackPanel></Grid></Border>
              <InfoBar x:Name="GameNotice" IsOpen="True" IsClosable="False" Severity="Informational" Title="Automatic DX12 detection" Message="Launch a Steam game in DX12. Its rendering executable and original Intel driver are identified automatically." />
              <StackPanel x:Name="SafetyPanel" Visibility="Collapsed" Spacing="4"><InfoBar x:Name="SafetyNotice" IsOpen="False" IsClosable="False" /><Expander Header="Why this warning?" HorizontalAlignment="Stretch"><TextBlock x:Name="SafetyDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}" /></Expander></StackPanel><Border x:Name="CapCard" Style="{StaticResource Card}"><StackPanel Spacing="15"><Grid><TextBlock Text="Choose a limit" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="CurrentCap" Text="No private setup" Visibility="Collapsed" Style="{StaticResource Muted}" /></Grid><TextBlock Text="Choose the shader-cache file limit for this game. The original system driver stays unchanged." Style="{StaticResource Muted}" /><ComboBox x:Name="CapChoice" SelectionChanged="CapChanged" SelectedIndex="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="512 MiB · unchanged driver" Tag="512" /><ComboBoxItem Content="1 GiB" Tag="1024" /><ComboBoxItem Content="2 GiB · experimental" Tag="2048" /><ComboBoxItem Content="4 GiB · experimental" Tag="4096" /><ComboBoxItem Content="8 GiB · reload experiment" Tag="8192" /><ComboBoxItem Content="16 GiB · high RAM risk" Tag="16384" /></ComboBox><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ApplyButton" Content="Apply to this game" Style="{StaticResource AccentButtonStyle}" Click="ApplyGame" IsEnabled="False" /><Button x:Name="RestoreButton" Content="Use system driver again" Click="RestoreGame" IsEnabled="False" /></StackPanel><TextBlock Text="EXPERIMENTAL BUILD · 8/16 GiB include a reload patch. A large cache can require equally large RAM buffers. Cache capacity and game compatibility are unverified." FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Check the running game" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Launch the game in DX12, then check which driver it is using." Style="{StaticResource Muted}" /><TextBlock x:Name="RuntimeStatus" Text="Driver check: not checked" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Check loaded driver" Click="ObserveGame" /><Button x:Name="MonitorButton" Content="Show live overlay" Click="ToggleCacheMonitor" /></StackPanel><Expander Header="Recovery and technical details" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><Button x:Name="ImportButton" Content="Import recovery receipt…" Click="ImportSetup" /><TextBlock x:Name="GameDetails" Text="Select a game to see its install folder and recovery record." TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" /></StackPanel></Expander></StackPanel></Border>
<Expander Header="Shader compilation (SCSKiller)" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock x:Name="ScsSummary" Text="Compilation uses the system driver (512 MiB)." Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ScsStatusButton" Content="Check SCSKiller status" Click="ScsStatus" /><Button x:Name="ScsCompileButton" Content="Compile with SCSKiller…" Click="ScsCompile" /><Button x:Name="ScsCancelButton" Content="Stop SCSKiller task" Click="CancelScs" Visibility="Collapsed" /></StackPanel><TextBlock Text="Community access and game support depend on SCSKiller. Set up its account and enable community downloads there. Choose its CLI in Settings." FontSize="12" Style="{StaticResource Muted}" /></StackPanel></Expander>            </StackPanel></ScrollViewer>
          </Grid>
        </Grid>
        <ScrollViewer x:Name="DriverPanel" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Left"><TextBlock Text="Your Intel driver" FontSize="32" FontWeight="SemiBold" /><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock x:Name="DriverTitle" Text="Inspecting the installed driver…" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="DriverSummary" Style="{StaticResource Muted}" /><Button Content="Check new DLLs" Click="InspectDriver" HorizontalAlignment="Left" /><Expander Header="Compatibility report: Xe2, Xe3 and XeH" HorizontalAlignment="Stretch"><TextBlock x:Name="DriverDetails" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Expander></StackPanel></Border><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Keep the system driver original" Message="Per-game copies do not require a global patched driver. This app does not replace system files. Use Intel's official installer for system-driver recovery." /></StackPanel></ScrollViewer>
        <Grid x:Name="ActivityPanel" Visibility="Collapsed" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Activity and results" FontSize="32" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Text="Every action records its result. Failed validation stops changes and keeps the recovery record." Style="{StaticResource Muted}" /><TextBox x:Name="ActivityLog" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Grid>
        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"><StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Left"><TextBlock Text="Settings" FontSize="32" FontWeight="SemiBold" /><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="SCSKiller connection" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="ScsPath" Text="Choose your installed SCSKiller CLI." TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Muted}" /><Button Content="Choose scskiller.exe…" Click="ChooseScsCli" HorizontalAlignment="Left" /><TextBlock Text="Choose the CLI build, not SCSKiller.App.exe. Commands run only after confirmation and stream results to Activity." Style="{StaticResource Muted}" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Steam library" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Installed titles are read locally. No Steam account sign-in or API key is needed." Style="{StaticResource Muted}" /><Button Content="Choose Steam folder…" Click="ChooseSteamFolder" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Use private drivers" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="OverrideStatus" Text="Checking whether private drivers can load…" Style="{StaticResource Muted}" /><TextBlock Text="Required for per-game cache limits. Enable once, restart Windows, then use this app normally. Your installed Intel driver stays unchanged. Games without a private setup keep using it." TextWrapping="Wrap" Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Enable private drivers…" Click="EnableRouting" /><Button Content="Restore previous Windows setting…" Click="RestoreRouting" /></StackPanel><TextBlock Text="Want to undo just one game? Choose Use system driver again on that game’s page. You do not need to change this Windows setting." TextWrapping="Wrap" Style="{StaticResource Muted}" /><Expander Header="What changes in Windows?"><TextBlock Text="DevOverrideEnable lets Windows respect .exe.local DLL redirection even for apps with a manifest. It is machine-wide and can affect other apps with .local setups. It does not replace the installed driver or turn off signature/integrity enforcement. Enable or restore requires manually running this app as administrator, confirmation, and a Windows restart. Restore uses the saved previous value; remove private game setups first." TextWrapping="Wrap" /></Expander></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="Troubleshooting" FontSize="20" FontWeight="SemiBold" /><ToggleSwitch x:Name="DiagnosticToggle" Header="Detailed diagnostic logging" OffContent="Off" OnContent="On" Toggled="DiagnosticToggled" /><TextBlock Text="Turn this on before reproducing a problem. Logs record driver checks, game paths, worker results, timings and errors. They stay on your PC and are never uploaded automatically. Review personal paths before sharing. Logs are limited to two files of about 2 MiB each." TextWrapping="Wrap" Style="{StaticResource Muted}" /><Button Content="Open logs folder" Click="OpenLogs" HorizontalAlignment="Left" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Preview build" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="WinUI 3 · C# · x64. No Python or PowerShell subprocesses. DLLs remain local to your computer. Unknown game builds and driver files are blocked. Multiplayer compatibility is not verified." Style="{StaticResource Muted}" /></StackPanel></Border></StackPanel></ScrollViewer>
      </Grid>
    </NavigationView>
    <InfoBar x:Name="GlobalNotice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning" />
    <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="24,10"><Grid><StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" /><TextBlock x:Name="FooterStatus" Text="Ready · no background game or system changes" FontSize="12" Style="{StaticResource Muted}" /></StackPanel><TextBlock Text="Private copies · explicit per-game changes" FontSize="12" HorizontalAlignment="Right" Style="{StaticResource Muted}" /></Grid></Border>
  </Grid>
</Window>
